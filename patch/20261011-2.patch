+                                 "CR, FTN, PRN, BLK or NOBLK\n", (int) val_len, v);
+                    return false;
+                }
+            } else {
+                report_error("%%ODS2-E-BADVALUE, /ATTRIBUTES: unknown keyword \"%.*s\" - "
