     unsigned got;
     ods2_result_t r;
 
     if (want == 0) want = vol->home.cluster;
-    if (map_offset + map_bytes + 4 > map_end || map_end > 510) {
+    /* Check first, before taking any blocks, that the smallest pointer
+       (4 bytes) could still fit; the exact size is checked after
