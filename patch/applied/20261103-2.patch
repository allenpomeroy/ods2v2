+static bool failing_read(void *ctx_, uint8_t *buf, size_t n)
+{
+    failing_source_t *fs = (failing_source_t *) ctx_;
+    if (n > fs->largest) fs->largest = n;
+    if (fs->delivered + n > fs->fail_after) return false;
+    memset(buf, 0, n);
+    fs->delivered += n;
+    return true;
+}
