diff --git a/include/ods2_volume.h b/include/ods2_volume.h
index de7c194..f79e47f 100644
--- a/include/ods2_volume.h
+++ b/include/ods2_volume.h
@@ -292,6 +292,53 @@ ods2_result_t ods2_create_file(ods2_volume_t *vol, const uint8_t *parent_header,
                                 const char *name, const uint8_t *content, size_t content_len,
                                 uint8_t rtype, ods2_fid_t *new_fid_out);
 
+/* RMS record attributes for a new file (FH2$W_RECATTR, spec 3.5.2.9).
+   Record formats (FAT$B_RTYPE, sequential organization): */
+#define ODS2_RFM_UDF   0 /* FAB$C_UDF: undefined - a stream of bytes */
+#define ODS2_RFM_FIX   1 /* FAB$C_FIX: fixed-length records */
+#define ODS2_RFM_VAR   2 /* FAB$C_VAR: variable-length (not importable) */
+#define ODS2_RFM_VFC   3 /* FAB$C_VFC: variable with control (not importable) */
+#define ODS2_RFM_STM   4 /* FAB$C_STM: stream, CR-LF terminated */
+#define ODS2_RFM_STMLF 5 /* FAB$C_STMLF: stream, LF terminated */
+#define ODS2_RFM_STMCR 6 /* FAB$C_STMCR: stream, CR terminated */
+/* Record attributes (FAT$B_RATTRIB), combinable as bits: */
+#define ODS2_RAT_FTN   0x01 /* FAB$M_FTN: FORTRAN carriage control */
+#define ODS2_RAT_CR    0x02 /* FAB$M_CR: implied carriage return */
+#define ODS2_RAT_PRN   0x04 /* FAB$M_PRN: print-file carriage control */
+#define ODS2_RAT_BLK   0x08 /* FAB$M_BLK: records don't span blocks */
+
+typedef struct {
+    uint8_t  rtype;   /* ODS2_RFM_* */
+    uint8_t  rattrib; /* ODS2_RAT_* bits; at most one of FTN/CR/PRN */
+    uint16_t rsize;   /* FAT$W_RSIZE: the record size of a fixed file,
+                         otherwise the longest record (LRL) */
+    uint16_t maxrec;  /* FAT$W_MAXREC (MRS): maximum record size; for a
+                         fixed file always equal to rsize, as VMS sets
+                         it (e.g. INDEXF.SYS: FIX, RSIZE = MRS = 512) */
+} ods2_record_attrs_t;
+
+/* Checks `attrs` as the record attributes of a new file holding
+ * `content_len` bytes taken from the host as they are. Returns NULL if
+ * they're acceptable, else why not:
+ *  - only UDF, FIX and the stream formats: VAR and VFC files carry a
+ *    count word before each record on disk, which host bytes don't;
+ *  - a fixed record size is 2..32766 bytes and even (RMS pads an odd
+ *    fixed record to a word boundary on disk - not supported), MRS
+ *    equals it, and the content is a whole number of records;
+ *  - other sizes are at most 32767; unknown RAT bits, or more than one
+ *    carriage control, are refused. */
+const char *ods2_check_record_attrs(const ods2_record_attrs_t *attrs, size_t content_len);
+
+/* ods2_create_file() with chosen record attributes, checked first by
+ * ods2_check_record_attrs() - a file whose attributes don't fit its
+ * content is refused, not created. ods2_create_file(..., rtype, ...)
+ * is this with rattrib 0 and RSIZE = MRS = 512, unchecked, as before.
+ */
+ods2_result_t ods2_create_file_attrs(ods2_volume_t *vol, const uint8_t *parent_header,
+                                      const char *name, const uint8_t *content,
+                                      size_t content_len, const ods2_record_attrs_t *attrs,
+                                      ods2_fid_t *new_fid_out);
+
 /* Inserts (name, version, fid) into the directory whose header is at
  * `dir_file_number`, trying each of its existing content blocks
  * first; if none have room, allocates a new block, extends the
diff --git a/src/ods2_volume.c b/src/ods2_volume.c
index 5a71e94..6842630 100644
--- a/src/ods2_volume.c
+++ b/src/ods2_volume.c
@@ -1326,9 +1326,85 @@ static ods2_result_t write_extents(ods2_volume_t *vol, const ods2_extent_t *exte
     return ok();
 }
 
+static ods2_result_t create_file(ods2_volume_t *vol, const uint8_t *parent_header,
+                                 const char *name, const uint8_t *content, size_t content_len,
+                                 const ods2_record_attrs_t *attrs, ods2_fid_t *new_fid_out);
+
+const char *ods2_check_record_attrs(const ods2_record_attrs_t *attrs, size_t content_len)
+{
+    unsigned cc = attrs->rattrib & (ODS2_RAT_FTN | ODS2_RAT_CR | ODS2_RAT_PRN);
+
+    switch (attrs->rtype) {
+    case ODS2_RFM_FIX:
+        if (attrs->rsize == 0) {
+            return "a fixed-length record format needs a record size";
+        }
+        if (attrs->rsize > 32766) {
+            return "fixed record size is too large (at most 32766 bytes)";
+        }
+        if (attrs->rsize % 2 != 0) {
+            return "odd fixed record sizes are not supported (RMS pads each such "
+                   "record to an even length on disk)";
+        }
+        if (attrs->maxrec != attrs->rsize) {
+            return "for fixed-length records the maximum record size (MRS) must "
+                   "equal the record size";
+        }
+        if (content_len % attrs->rsize != 0) {
+            return "content length is not a whole number of fixed-length records";
+        }
+        break;
+    case ODS2_RFM_UDF:
+    case ODS2_RFM_STM:
+    case ODS2_RFM_STMLF:
+    case ODS2_RFM_STMCR:
+        if (attrs->rsize > 32767 || attrs->maxrec > 32767) {
+            return "record size is too large (at most 32767 bytes)";
+        }
+        break;
+    case ODS2_RFM_VAR:
+    case ODS2_RFM_VFC:
+        return "variable-length record formats (VAR, VFC) can't be imported: on "
+               "disk each record starts with a byte count the host file doesn't have";
+    default:
+        return "unknown record format";
+    }
+    if (attrs->rattrib & ~0x0fu) {
+        return "unknown record attribute bits";
+    }
+    if (cc != 0 && (cc & (cc - 1)) != 0) {
+        return "only one carriage control (FTN, CR or PRN) can be given";
+    }
+    return NULL;
+}
+
+ods2_result_t ods2_create_file_attrs(ods2_volume_t *vol, const uint8_t *parent_header,
+                                      const char *name, const uint8_t *content,
+                                      size_t content_len, const ods2_record_attrs_t *attrs,
+                                      ods2_fid_t *new_fid_out)
+{
+    const char *why = ods2_check_record_attrs(attrs, content_len);
+    if (why != NULL) {
+        return fail(why);
+    }
+    return create_file(vol, parent_header, name, content, content_len, attrs, new_fid_out);
+}
+
 ods2_result_t ods2_create_file(ods2_volume_t *vol, const uint8_t *parent_header,
                                 const char *name, const uint8_t *content, size_t content_len,
                                 uint8_t rtype, ods2_fid_t *new_fid_out)
+{
+    ods2_record_attrs_t attrs;
+    attrs.rtype = rtype;
+    attrs.rattrib = 0;
+    attrs.rsize = 512;
+    attrs.maxrec = 512;
+    return create_file(vol, parent_header, name, content, content_len, &attrs, new_fid_out);
+}
+
+static ods2_result_t create_file(ods2_volume_t *vol, const uint8_t *parent_header,
+                                 const char *name, const uint8_t *content, size_t content_len,
+                                 const ods2_record_attrs_t *attrs, ods2_fid_t *new_fid_out)
 {
     const ods2_head_core_t *parent_core = (const ods2_head_core_t *) parent_header;
     ods2_fid_t existing;
@@ -1462,10 +1538,10 @@ ods2_result_t ods2_create_file(ods2_volume_t *vol, const uint8_t *parent_header,
     if (!r.ok) goto undo;
 
     memset(&spec, 0, sizeof(spec));
-    spec.rtype = rtype;
-    spec.rattrib = 0;
-    spec.rsize = 512;
-    spec.maxrec = 512;
+    spec.rtype = attrs->rtype;
+    spec.rattrib = attrs->rattrib;
+    spec.rsize = attrs->rsize;
+    spec.maxrec = attrs->maxrec;
     /* Records the whole file's size in every header, as the record
        attributes are copied into extension headers too. */
     spec.hiblk = (uint32_t) total_allocated;
diff --git a/tests/cli_record_attrs_check.sh b/tests/cli_record_attrs_check.sh
new file mode 100644
index 0000000..367d1d6
--- /dev/null
+++ b/tests/cli_record_attrs_check.sh
@@ -0,0 +1,119 @@
+#!/bin/sh
+# MIT License - Copyright (c) 2026 Allen Pomeroy (see LICENSE)
+#
+# cli_record_attrs_check.sh - RMS record attributes of host imports:
+# `ods2 COPY/ATTRIBUTES=(...)` and `ods2_put ... rtype rsize rattrib`
+# set the record format, record size and record attributes in the new
+# file's header (read back with ods2_dump_header), e.g. the fixed
+# 8192-byte records OpenVMS PCSI kit files need; plain COPY is still
+# Stream_LF; attributes that don't fit the content are refused with
+# exit status 1 and no file. Called by `make test`; run from the
+# project root.
+
+SRC_DISK=samples/synthetic_disk.img
+DISK=samples/cli_attrs_disk.img
+ODS2=./ods2
+PUT=./ods2_put
+DUMP=./ods2_dump_header
+TMP=samples/cli_attrs_tmp
+fails=0
+
+check() { # check <description> <expected> <actual>
+    if [ "$2" = "$3" ]; then
+        echo "PASS: $1"
+    else
+        echo "FAIL: $1"
+        echo "      expected: $2"
+        echo "      got:      $3"
+        fails=$((fails + 1))
+    fi
+}
+
+status() { "$@" >/dev/null 2>&1; echo $?; }
+
+[ -f "$SRC_DISK" ] || { echo "FAIL: $SRC_DISK missing"; exit 1; }
+for t in $PUT $DUMP; do [ -x $t ] || { echo "FAIL: $t not built"; exit 1; }; done
+rm -f "$DISK"
+cp "$SRC_DISK" "$DISK"
+mkdir -p "$TMP"
+
+head -c 16384 /dev/zero | tr '\0' 'K' > "$TMP/kit.pcsi"     # 2 records of 8192
+head -c 16000 /dev/zero | tr '\0' 'S' > "$TMP/short.pcsi"   # not whole records
+printf 'line one\nline two\n' > "$TMP/notes.txt"
+
+# File numbers are handed out in order on this fresh disk, so each
+# successful create below takes the next one; read them from the COPY
+# itself where possible: ods2_put prints FID=(num,...).
+next_fid() { $PUT "$@" | sed -n 's/.*FID=(\([0-9]*\),.*/\1/p'; }
+hdr() { $DUMP $DISK "$1" | tr -s ' ' '\n' | grep -E '^(rtype|rattrib|rsize|maxrec)=' | tr '\n' ' ' | sed 's/ $//'; }
+
+# --- ods2_put ---
+n=$(next_fid $DISK $TMP/kit.pcsi '' PUT8192.PCSI 1 8192)
+check "ods2_put 1 8192: fixed 8192-byte records" \
+    "rtype=0x01 rattrib=0x00 rsize=8192 maxrec=8192" "$(hdr $n)"
+n=$(next_fid $DISK $TMP/kit.pcsi '' PUT512.DAT 1)
+check "ods2_put 1: fixed 512-byte records by default" \
+    "rtype=0x01 rattrib=0x00 rsize=512 maxrec=512" "$(hdr $n)"
+n=$(next_fid $DISK $TMP/notes.txt '' PUTCR.TXT 5 512 2)
+check "ods2_put 5 512 2: Stream_LF with CR carriage control" \
+    "rtype=0x05 rattrib=0x02 rsize=512 maxrec=512" "$(hdr $n)"
+check "ods2_put refuses content that isn't whole records (exit 1)" 1 \
+    "$(status $PUT $DISK $TMP/short.pcsi '' SHORT.PCSI 1 8192)"
+check "ods2_put refuses VAR (exit 1)" 1 "$(status $PUT $DISK $TMP/notes.txt '' V.TXT 2)"
+check "ods2_put refuses a non-numeric size (exit 1)" 1 \
+    "$(status $PUT $DISK $TMP/kit.pcsi '' X.PCSI 1 8k)"
+
+# --- ods2 COPY ---
+# Each successful COPY takes the next file number after the last one.
+check "COPY/ATTRIBUTES=(RFM:FIX,MRS:8192) succeeds" \
+    "%ODS2-I-COPIED, 16384 bytes to KIT.PCSI;1" \
+    "$($ODS2 $DISK "COPY/ATTRIBUTES=(RFM:FIX,MRS:8192) $TMP/kit.pcsi [000000]KIT.PCSI" 2>&1)"
+n=$((n + 1))
+check "...with fixed 8192-byte records in the header" \
+    "rtype=0x01 rattrib=0x00 rsize=8192 maxrec=8192" "$(hdr $n)"
+$ODS2 $DISK "TYPE [000000]KIT.PCSI" > "$TMP/out.bin" 2>/dev/null
+if cmp -s "$TMP/kit.pcsi" "$TMP/out.bin"; then same=identical; else same=different; fi
+check "...and reads back byte for byte" identical "$same"
+
+$ODS2 $DISK "COPY/ATTR=(RFM:FIXED,LRL:8192) $TMP/kit.pcsi [000000]LRL.PCSI" >/dev/null 2>&1
+n=$((n + 1))
+check "LRL alone sets a fixed record size too; /ATTR abbreviation" \
+    "rtype=0x01 rattrib=0x00 rsize=8192 maxrec=8192" "$(hdr $n)"
+$ODS2 $DISK "copy/attributes=rfm:fix $TMP/kit.pcsi [000000]F512.DAT" >/dev/null 2>&1
+n=$((n + 1))
+check "RFM:FIX with no size: 512-byte records; lowercase, no parentheses" \
+    "rtype=0x01 rattrib=0x00 rsize=512 maxrec=512" "$(hdr $n)"
+$ODS2 $DISK "COPY/ATTRIBUTES=(RFM:STMLF,RAT:CR) $TMP/notes.txt [000000]NOTES.TXT" >/dev/null 2>&1
+n=$((n + 1))
+check "RFM:STMLF,RAT:CR" "rtype=0x05 rattrib=0x02 rsize=512 maxrec=512" "$(hdr $n)"
+$ODS2 $DISK "COPY/ATTRIBUTES=(RFM:UDF,RAT:NONE,MRS:0,LRL:0) $TMP/notes.txt [000000]RAW.DAT" >/dev/null 2>&1
+n=$((n + 1))
+check "RFM:UDF with sizes 0" "rtype=0x00 rattrib=0x00 rsize=0 maxrec=0" "$(hdr $n)"
+$ODS2 $DISK "COPY $TMP/notes.txt [000000]PLAIN.TXT" >/dev/null 2>&1
+n=$((n + 1))
+check "plain COPY is still Stream_LF, 512, no RAT" \
+    "rtype=0x05 rattrib=0x00 rsize=512 maxrec=512" "$(hdr $n)"
+
+check "COPY of content that isn't whole records exits 1" 1 \
+    "$(status $ODS2 $DISK "COPY/ATTRIBUTES=(RFM:FIX,MRS:8192) $TMP/short.pcsi [000000]SHORT.PCSI")"
+check "...and creates no file" "%ODS2-W-NOFILES, no files found" \
+    "$($ODS2 $DISK 'DIR [000000]SHORT.PCSI' 2>&1)"
+check "MRS different from LRL for FIX exits 1" 1 \
+    "$(status $ODS2 $DISK "COPY/ATTRIBUTES=(RFM:FIX,MRS:8192,LRL:512) $TMP/kit.pcsi [000000]REFUSED1.PCSI")"
+check "an odd fixed size exits 1" 1 \
+    "$(status $ODS2 $DISK "COPY/ATTRIBUTES=(RFM:FIX,MRS:8191) $TMP/kit.pcsi [000000]REFUSED2.PCSI")"
+check "RFM:VAR exits 1" 1 \
+    "$(status $ODS2 $DISK "COPY/ATTRIBUTES=(RFM:VAR) $TMP/notes.txt [000000]REFUSED3.TXT")"
+check "an unknown record format exits 1" 1 \
+    "$(status $ODS2 $DISK "COPY/ATTRIBUTES=(RFM:XYZ) $TMP/notes.txt [000000]REFUSED4.TXT")"
+check "an unknown qualifier exits 1" 1 \
+    "$(status $ODS2 $DISK "COPY/BOGUS $TMP/notes.txt [000000]REFUSED5.TXT")"
+check "two carriage controls exit 1" 1 \
+    "$(status $ODS2 $DISK "COPY/ATTRIBUTES=(RFM:STMLF,RAT:CR,RAT:FTN) $TMP/notes.txt [000000]REFUSED6.TXT")"
+check "a missing ')' exits 1" 1 \
+    "$(status $ODS2 $DISK "COPY/ATTRIBUTES=(RFM:FIX $TMP/kit.pcsi [000000]REFUSED7.PCSI")"
+check "none of the refused copies created a file" "%ODS2-W-NOFILES, no files found" \
+    "$($ODS2 $DISK 'DIR [000000]REFUSED*.*' 2>&1)"
+
+rm -rf "$TMP" "$DISK"
+[ "$fails" -eq 0 ] || { echo "$fails CLI record attribute check(s) failed"; exit 1; }
diff --git a/tests/ods2_record_attrs_selftest.c b/tests/ods2_record_attrs_selftest.c
new file mode 100644
index 0000000..3e91b72
--- /dev/null
+++ b/tests/ods2_record_attrs_selftest.c
@@ -0,0 +1,242 @@
+/*
