diff --git a/tests/ods2_indexf_large_selftest.c b/tests/ods2_indexf_large_selftest.c
new file mode 100644
index 0000000..0dc9edd
--- /dev/null
+++ b/tests/ods2_indexf_large_selftest.c
@@ -0,0 +1,230 @@
