From 7a06813777b621c9519ef29a1adfe8cddd14410a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 12 Oct 2026 21:45:52 -0500
Subject: [PATCH] Directories VMS made: move FH2$L_HIGHWATER when blocks are
 added

A directory INITIALIZE (or VMS) created carries a high-water mark,
e.g. HIGHWATER 2 on the root: only VBN 1 ever written. On a volume
with high-water marking (the INITIALIZE default) VMS reads every block
at or past the mark as zeros. When an insert split such a directory,
ods2v2 wrote VBN 2 and raised the EOF but left HIGHWATER at 2, so VMS
read VBN 2 as zeros: BAD_NAMEORDER "... and [empty]", BAD_DIRSIZE,
BADIRECTORY, and DIR stopping at the end of VBN 1. Host-side reads
the raw blocks, so ods2 itself listed everything.

store_directory() now raises a non-zero HIGHWATER past every block it
writes (to HIBLK+1 when the directory moves, since the new area is
written in full). A single-block update to a block at or past the mark
goes through store_directory() so the header moves with it.

ods2_check_headers reports any header whose HIGHWATER is below its
end-of-file. ods2_dir_order_selftest checks every block inside the EOF
is below the mark, and reproduces the report: the six kit names into
INITIALIZE's root (split), then 40 more (move past 3 blocks).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01ECfiwrtCZ81tDq7Ak5QAMT
---
 src/ods2_volume.c               | 28 ++++++++++++++++++--
 tests/ods2_dir_order_selftest.c | 45 +++++++++++++++++++++++++++++++++
 tools/ods2_check_headers.c      | 23 ++++++++++++++---
 3 files changed, 91 insertions(+), 5 deletions(-)

diff --git a/src/ods2_volume.c b/src/ods2_volume.c
index 6842630..a443057 100644
--- a/src/ods2_volume.c
+++ b/src/ods2_volume.c
@@ -1640,6 +1640,14 @@ undo:
  *
  * The end-of-file becomes EFBLK used+1 / FFBYTE 0, as VMS writes it,
  * and the directory's revision count and date go up. */
+/* True when VMS will read back what is written at `vbn`: the file is
+   not high-water marked, or `vbn` is below its high-water mark. */
+static bool below_highwater(const uint8_t *header, unsigned vbn)
+{
+    const ods2_head_core_t *core = (const ods2_head_core_t *) header;
+    return core->highwater == 0 || vbn < core->highwater;
+}
+
 static ods2_result_t store_directory(ods2_volume_t *vol, unsigned dir_file_number,
                                      uint8_t *dir_header, const uint8_t *blocks,
                                      unsigned used, unsigned old_used, unsigned first_changed)
@@ -1706,6 +1714,17 @@ static ods2_result_t store_directory(ods2_volume_t *vol, unsigned dir_file_numbe
 
     core->recattr.efblk = ods2_word_swap32(used + 1);
     core->recattr.ffbyte = 0;
+    /* FH2$L_HIGHWATER: the first VBN never written. On a volume with
+       high-water marking (the INITIALIZE default), VMS returns zeros
+       for any read at or past it, whatever is on the disk. A directory
+       INITIALIZE made carries HIGHWATER 2 (only VBN 1 written), so a
+       block added past it reads back on VMS as a zero record:
+       BAD_NAMEORDER "[empty]", BAD_DIRSIZE, BADIRECTORY. Zero means
+       the file isn't high-water marked, and stays zero. */
+    if (core->highwater != 0) {
+        uint32_t written = moved ? ods2_word_swap32(core->recattr.hiblk) : used;
+        if (core->highwater < written + 1) core->highwater = written + 1;
+    }
     {
         /* FI2$W_REVISION / FI2$Q_REVDATE; FI2$Q_CREDATE stays. */
         uint8_t *ident = dir_header + (size_t) core->idoffset * 2;
@@ -1790,8 +1809,10 @@ ods2_result_t ods2_insert_into_directory(ods2_volume_t *vol, unsigned dir_file_n
 
     t = ods2_dir_choose_block(blocks, used, name);
     if (ods2_insert_dir_entry(blocks + (size_t) t * 512, 512, name, version, fid)) {
-        if (ods2_file_content_length(dir_header) == 0) {
-            /* An end-of-file that didn't cover even block 1 */
+        if (ods2_file_content_length(dir_header) == 0 ||
+            !below_highwater(dir_header, t + 1)) {
+            /* An end-of-file that didn't cover even block 1, or a block
+               VMS would read as zeros until the high-water mark moves */
             r = store_directory(vol, dir_file_number, dir_header, blocks, used, used, t);
         } else {
             r = ods2_write_file_block(vol, dir_header, t + 1, blocks + (size_t) t * 512);
@@ -2030,6 +2051,9 @@ ods2_result_t ods2_delete_version(ods2_volume_t *vol, unsigned dir_file_number,
                 memmove(block, block + 512, (size_t) (used - v - 1) * 512);
                 r = store_directory(vol, dir_file_number, dir_header, blocks, used - 1,
                                     used, v);
+            } else if (!below_highwater(dir_header, v + 1)) {
+                r = store_directory(vol, dir_file_number, dir_header, blocks, used,
+                                    used, v);
             } else {
                 r = ods2_write_file_block(vol, dir_header, v + 1, block);
             }
diff --git a/tests/ods2_dir_order_selftest.c b/tests/ods2_dir_order_selftest.c
index 026f562..c462107 100644
--- a/tests/ods2_dir_order_selftest.c
+++ b/tests/ods2_dir_order_selftest.c
@@ -76,6 +76,9 @@ static unsigned check_directory(ods2_volume_t *vol, unsigned dir_num, int expect
     assert(core->filechar & 0x0080u);                /* FH2$M_CONTIG */
     used = (unsigned) ((ods2_file_content_length(h) + 511) / 512);
     assert(used >= 1 && used <= extents[0].block_count);
+    /* VMS reads blocks at or past FH2$L_HIGHWATER as zeros: every
+       block inside the EOF must be below it (0 = not marked). */
+    assert(core->highwater == 0 || used < core->highwater);
     for (v = 1; v <= used; v++) {
         ods2_dir_entry_t e[ODS2_DIR_MAX_ENTRIES_PER_BLOCK];
         int n, i;
@@ -183,6 +186,48 @@ int main(void)
                "(%u -> %u in use), order and EOF intact\n", n, before, used);
     }
 
+    /* The root as INITIALIZE made it: HIGHWATER 2, only VBN 1 ever
+       written. Six long names (the ones from the report) split it into
+       two blocks; VBN 2 must be below the high-water mark or VMS reads
+       it as zeros (BAD_NAMEORDER "[empty]", BADIRECTORY). More names
+       then outgrow its three blocks, moving it. */
+    {
+        static const char *kits[] = {
+            "DEC-AXPVMS-DNVOSIECO03-V0703-2-4.PCSI",
+            "DEC-AXPVMS-DNVOSIMUP01-V0703-2-4.PCSI",
+            "DEC-AXPVMS-TCPIP-V0504-15ECO7-1.PCSI",
+            "DEC-AXPVMS-VMS732_PCSI-V0600--4.PCSI$COMPRESSED",
+            "DEC-AXPVMS-VMS732_TZ-V0300--4.PCSI$COMPRESSED",
+            "DEC-AXPVMS-VMS732_UPDATE-V2200--4.PCSI$COMPRESSED",
+        };
+        uint8_t h[512];
+        const ods2_head_core_t *core = (const ods2_head_core_t *) h;
+        int entries, k;
+        assert(ods2_read_header(&vol, 4, h).ok);
+        assert(core->highwater == 2);       /* as INITIALIZE left it */
+        assert(ods2_count_directory_entries(&vol, h, &entries).ok);
+        for (k = 0; k < 6; k++) {
+            create_in(&vol, 4, kits[k]);
+            entries++;
+            used = check_directory(&vol, 4, entries, NULL);
+        }
+        assert(used == 2);
+        assert(ods2_read_header(&vol, 4, h).ok);
+        printf("PASS: six long names split INITIALIZE's root into %u blocks; "
+               "HIGHWATER moved 2 -> %u with the EOF\n", used,
+               (unsigned) core->highwater);
+        for (k = 0; k < 40; k++) {
+            snprintf(name, sizeof name, "DEC-AXPVMS-FILLER%02d-V0100--1.PCSI$COMPRESSED", k);
+            create_in(&vol, 4, name);
+            entries++;
+            used = check_directory(&vol, 4, entries, NULL);
+        }
+        assert(used > 3);
+        assert(ods2_read_header(&vol, 4, h).ok);
+        printf("PASS: root grown to %u blocks, moved past its 3, HIGHWATER %u "
+               "covers them all\n", used, (unsigned) core->highwater);
+    }
+
     /* MAKEFILE is stored as MAKEFILE. and found either way. */
     {
         uint8_t h[512], content = 'x';
diff --git a/tools/ods2_check_headers.c b/tools/ods2_check_headers.c
index be12e77..dd04098 100644
--- a/tools/ods2_check_headers.c
+++ b/tools/ods2_check_headers.c
@@ -26,6 +26,11 @@
  * disk image and reports, for each, whether FAT$L_HIBLK matches the
  * sum of that header's own retrieval pointer extents. 
  *
+ * It also flags a FH2$L_HIGHWATER below the end-of-file: on a volume
+ * with high-water marking, VMS reads every block at or past the mark
+ * as zeros, so content there is invisible to VMS (a directory shows
+ * BADIRECTORY / BAD_NAMEORDER "[empty]").
+ *
  * Usage: ods2_check_headers <disk-image> [count]
  *   count defaults to 16 (the range locatable directly from the home
  *   block alone, per spec 5.1.7).
@@ -42,7 +47,7 @@ int main(int argc, char **argv)
     ods2_result_t r;
     unsigned count = 16;
     unsigned n;
-    int mismatches = 0, checked = 0;
+    int mismatches = 0, checked = 0, below_hw = 0;
 
     if (argc < 2) {
         fprintf(stderr, "usage: %s <disk-image> [count]\n", argv[0]);
@@ -108,11 +113,23 @@ int main(int argc, char **argv)
                    vr.ok ? "checksum OK" : vr.problem);
 
             if (!extension && extent_sum != hiblk_fixed) mismatches++;
+
+            /* Last block holding data: EFBLK-1 when FFBYTE is 0. */
+            if (!extension && core->highwater != 0 && efblk_fixed != 0) {
+                uint32_t last = (core->recattr.ffbyte == 0) ? efblk_fixed - 1 : efblk_fixed;
+                if (last >= core->highwater) {
+                    printf("     ^ HIGHWATER %u is below the end-of-file: VMS reads "
+                           "VBN %u-%u as zeros\n", (unsigned) core->highwater,
+                           (unsigned) core->highwater, (unsigned) last);
+                    below_hw++;
+                }
+            }
         }
     }
 
-    printf("\n%d header(s) checked, %d hiblk/extent-sum mismatch(es)\n",
-           checked, mismatches);
+    printf("\n%d header(s) checked, %d hiblk/extent-sum mismatch(es), "
+           "%d high-water mark(s) below end-of-file\n",
+           checked, mismatches, below_hw);
 
     ods2_dismount(&vol);
     return 0;
-- 
2.43.0
